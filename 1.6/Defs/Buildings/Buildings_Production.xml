<Defs>

  <ThingDef ParentName="BenchBase">
    <defName>SRA_WorkTable</defName>
    <label>星规-构建机组</label>
    <description>编织星辉分形并将其演化为各种物品的工作台，小规模使用的打印装置，一般由旅行家使用。</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>SRA/Building/SRA_WorkTable</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3, 1)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>false</castEdgeShadows>
    <costList>
      <Plasteel>200</Plasteel>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>80</WorkToBuild>
      <MaxHitPoints>3200</MaxHitPoints>
      <Flammability>0</Flammability>
      <Mass>20</Mass>
      <WorkTableWorkSpeedFactor>1</WorkTableWorkSpeedFactor>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>SRA_Building</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>0</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <recipes>
      <li>SRA_Make_SRA_Core_By_Plasteel</li>
      <li>SRA_Make_SRA_Core_By_Steel</li>
      <li>SRA_Make_SRA_Core_By_Chemfuel</li>
      <li>SRA_Make_Plasteel_By_SRA_Core</li>
      <li>SRA_Make_Hyperweave_By_SRA_Core</li>
      <li>SRA_Make_Gold_By_SRA_Core</li>
      <li>SRA_Make_MedicineUltratech_By_SRA_Core</li>
      <li>SRA_Make_Neutroamine_By_SRA_Core</li>
      <li>SRA_Make_Steel_By_SRA_Core</li>
    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Breakdownable"/>
