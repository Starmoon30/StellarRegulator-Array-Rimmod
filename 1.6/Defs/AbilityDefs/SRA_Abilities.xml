<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbilityDef Name="SRA_PsychicSlaughter">
    <defName>SRA_PsychicSlaughter</defName>
    <label>扭曲触痕</label>
    <description>操纵现实，立即将目标扭曲为血肉碎块，这会立即杀死目标并生成扭曲肉。</description>
    <iconPath>UI/Abilities/Slaughter</iconPath>
    <cooldownTicksRange>600</cooldownTicksRange> <!-- 1 day -->
    <showPsycastEffects>true</showPsycastEffects>
    <aiCanUse>true</aiCanUse>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <stunTargetWhileCasting>true</stunTargetWhileCasting>
    <moteOffsetAmountTowardsTarget>0.5</moteOffsetAmountTowardsTarget>
    <warmupMote>Mote_HoraxSmallSpellWarmup</warmupMote>
    <warmupEffecter>HoraxianAbilityCasting</warmupEffecter>
    <warmupSound>AnomalyAbilityWarmup</warmupSound>
    <writeCombatLog>true</writeCombatLog>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0</warmupTime>
      <range>32</range>
      <requireLineOfSight>false</requireLineOfSight>
      <drawHighlightWithLineOfSight>false</drawHighlightWithLineOfSight>
      <targetParams>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetMechs>false</canTargetMechs>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_PsychicSlaughter" />
    </comps>
  </AbilityDef>


  
  <AbilityDef Name="SRA_EntitySkip">
    <defName>SRA_EntitySkip</defName>
    <label>转瞬思绪</label>
    <category MayRequire="Ludeon.RimWorld.Royalty">Skip</category>
    <description>扭曲现实，立即将周围的任意目标传送至目标地点。</description>
    <iconPath>UI/Abilities/Skip</iconPath>
    <showPsycastEffects>false</showPsycastEffects>
    <cooldownTicksRange>60</cooldownTicksRange> <!-- 3 to 8 seconds -->
    <aiCanUse>true</aiCanUse>
    <showOnCharacterCard>true</showOnCharacterCard>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_EntitySkip</verbClass>
      <drawAimPie>true</drawAimPie>
      <warmupTime>0</warmupTime>
      <range>64</range>
      <ai_IsWeapon>false</ai_IsWeapon>
      <targetParams>
        <canTargetSelf>True</canTargetSelf>
        <canTargetPawns>True</canTargetPawns>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityTeleport">
        <compClass>CompAbilityEffect_Teleport</compClass>
        <destination>Selected</destination>
        <requiresLineOfSight>false</requiresLineOfSight>
        <range>64</range>
        <clamorType>Ability</clamorType>
        <clamorRadius>1</clamorRadius>
        <destClamorType>Ability</destClamorType>
        <destClamorRadius>1</destClamorRadius>
        <maxBodySize>10</maxBodySize>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef Name="SRA_ReleaseDeadlifeDust">
    <defName>SRA_ReleaseDeadlifeDust</defName>
    <label>猎杀尸群</label>
    <description>在约八格半径内释放云雾，将范围内所有尸体变为活尸，攻击你的敌人</description>
    <iconPath>UI/Abilities/ReleaseDeadlifeDust</iconPath>
    <cooldownTicksRange>300</cooldownTicksRange> <!-- 1 day -->
    <showPsycastEffects>false</showPsycastEffects>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <hotKey>Misc1</hotKey>
    <hostile>false</hostile>
    <targetRequired>false</targetRequired>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <label>release deadlife dust</label>
      <drawAimPie>false</drawAimPie>
      <warmupTime>0</warmupTime>
      <violent>false</violent>
      <targetable>false</targetable>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
      <soundCast>DeadlifeRelease</soundCast>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityReleaseGas">
        <gasType>DeadlifeDust</gasType>
        <cellsToFill>113</cellsToFill>
      </li>
    </comps>
  </AbilityDef>

  
  <AbilityDef>
    <defName>SRA_ControlPulse</defName>
    <label>律令支配</label>
    <description>以铿锵有力的话语强行支配范围内所有目标的心智，使其为你而战一段时间。</description>
    <iconPath>UI/Abilities/BerserkPulse</iconPath>
    <writeCombatLog>True</writeCombatLog>
    <showPsycastEffects>False</showPsycastEffects>
    <cooldownTicksRange>60000</cooldownTicksRange> <!-- 1 day per -->
    <charges>6</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <statBases>
      <Ability_EffectRadius>5</Ability_EffectRadius>
      <Ability_Duration>500</Ability_Duration>
    </statBases>
    <warmupEffecter>HoraxianSpellLight_Warmup</warmupEffecter>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <defaultProjectile>Bullet_FleshmelterBolt</defaultProjectile>
      <range>64</range>
      <warmupTime>0</warmupTime>
      <soundCast>AgonyPulse_Cast</soundCast>
      <ai_IsWeapon>false</ai_IsWeapon>
      <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
      
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="CompProperties_AbilityGiveMentalState">
        <compClass>CompAbilityEffect_GiveMentalState</compClass>
        <stateDef>BerserkWarcall</stateDef>
        <goodwillImpact>0</goodwillImpact>
        <casterEffect>AnimalWarcall_Cast</casterEffect>
        <targetEffect>AnimalWarcall_CastOnTarget</targetEffect>
        <excludeNPCFactions>false</excludeNPCFactions>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastPsychicEffect</fleckDef>
      </li>
      <li Class="CompProperties_AbilityEffecterOnTarget">
        <effecterDef>AgonyPulseExplosion</effecterDef>
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>SRA_AnnihilateStorm</defName>
    <label>湮灭风暴</label>
    <description>在短暂准备后，轰炸目标区域，发射的高能射弹直击几乎能湮灭一切，随之而来的骇人爆炸更是能在巨大范围内造成毁灭性的破坏。</description>
    <iconPath>UI/Abilities/FireSpew</iconPath>
    <writeCombatLog>True</writeCombatLog>
    <showPsycastEffects>False</showPsycastEffects>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_AbilityShoot</verbClass>
      <defaultProjectile>SRABullet_L_Particle_Launcher</defaultProjectile>
      <range>64</range>
      <warmupTime>3</warmupTime>
      <muzzleFlashScale>9</muzzleFlashScale>
      <burstShotCount>8</burstShotCount>
      <accuracyTouch>0.8</accuracyTouch>
      <accuracyShort>0.8</accuracyShort>
      <accuracyMedium>0.8</accuracyMedium>
      <accuracyLong>0.8</accuracyLong>
      <beamTargetsGround>true</beamTargetsGround>
      <soundAiming>SRA_Windup</soundAiming>
      <ai_IsWeapon>false</ai_IsWeapon>
      <ai_ProjectileLaunchingIgnoresMeleeThreats>true</ai_ProjectileLaunchingIgnoresMeleeThreats>
      
      <requireLineOfSight>false</requireLineOfSight>
      
      <aimingLineMote>Mote_HellsphereCannon_Aim</aimingLineMote>
      <aimingChargeMote>Mote_HellsphereCannon_Charge</aimingChargeMote>
      <aimingChargeMoteOffset>1.07</aimingChargeMoteOffset>
      <aimingLineMoteFixedLength>32</aimingLineMoteFixedLength>
      <aimingTargetMote>Mote_HellsphereCannon_Target</aimingTargetMote>

      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetPlants>true</canTargetPlants>
      </targetParams>
    </verbProperties>
  </AbilityDef>
  <AbilityDef>
    <defName>SRA_Long_Lance_Ability</defName>
    <label>征洋戮海</label>
    <description>释放一道毁灭性的相位能量流，贯穿并灼烧路径上的一切。</description>
    <iconPath>SRA/UI/Abilities/SRA_Long_Lance_Ability</iconPath>
    <cooldownTicksRange>60000</cooldownTicksRange> <!-- 1 day per -->
    <charges>6</charges>
    <cooldownPerCharge>true</cooldownPerCharge>
    <aiCanUse>true</aiCanUse>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <!-- 保留原版 Ability 的施放链：前摇结束后由 Verb_CastAbility 调用效果组件。 -->
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1</warmupTime> <!-- 施法前摇，单位：秒。 -->
      <requireLineOfSight>false</requireLineOfSight> <!-- 相位束可越过遮挡物锁定目标位置。 -->
      <warmupEffecter>SRA_Mote_sun_flairs_out</warmupEffecter> <!-- 前摇阶段的蓄能视觉。 -->
      <range>64</range> <!-- 最大施法距离，单位：格。 -->
      <drawAimPie>false</drawAimPie> <!-- 不绘制原版扇形瞄准提示。 -->
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- 技能效果组件会在原版 Ability.Activate 后创建一次独立的光束控制器。 -->
      <li Class="SRA.CompProperties_AbilityExcaliburBeam">
        <beamDefName>SRA_ExcaliburBeam</beamDefName> <!-- 承担短时渲染与伤害时序的不可见控制器 Def。 -->
        <damageAmount>160</damageAmount> <!-- 光束每个游戏 tick 对束路内目标造成的直接伤害。 -->
        <armorPenetration>8</armorPenetration> <!-- 每 tick 直接伤害的护甲穿透。 -->
        <pathWidth>4</pathWidth> <!-- 移动光束中心线两侧的覆盖宽度，单位：格。 -->
        <damageDef>SRA_Spear_of_SRA_burn</damageDef> <!-- 相位束造成的伤害类型。 -->
        <targetignore>ignoreFriendly</targetignore> <!-- 忽略施法者同阵营与盟友，仍可伤害敌对和无阵营目标。 -->
        <visualDurationTicks>60</visualDurationTicks> <!-- 光束从近端扫至目标位置的总时长，单位：游戏 tick。 -->
        <sweepStartDistance>2.5</sweepStartDistance> <!-- 扫掠前沿距离施法者的初始距离，单位：格。 -->
        <beamStartOffset>0.75</beamStartOffset> <!-- 光束从施法者前方略微偏移，避免遮住施法者。 -->
        <beamMoteDef>Mote_SRA_Long_Lance</beamMoteDef> <!-- 征洋戮海专用的宽主束。 -->
        <extraBeamMoteDefs>
          <li>Mote_SRA_Long_Lance_SparkSheath</li> <!-- 沿束平铺并等比扩散的外层泛光。 -->
        </extraBeamMoteDefs>
        <beamGroundFleckDef>Fleck_SRA_M_Laser_GroundBurn</beamGroundFleckDef> <!-- 命中区域持续出现的地面灼烧。 -->
        <beamFleckChancePerTick>0.18</beamFleckChancePerTick> <!-- 每 tick 生成地面灼烧的概率。 -->
        <beamEndEffecterDef>SRA_M_Laser_End</beamEndEffecterDef> <!-- 命中端的冲击、飞溅与余烬效果。 -->
        <beamLineFleckDef>Fleck_SRA_M_Laser_LineSpark</beamLineFleckDef> <!-- 沿束稀疏生成的大尺寸电离火花。 -->
        <beamLineFleckChancePerCell>0.018</beamLineFleckChancePerCell> <!-- 每格每 tick 的沿束火花概率。 -->
        <beamSoundDef>SRA_M_Laser</beamSoundDef> <!-- 光束维持期间使用的持续音效。 -->
        <soundDef>SRA_star_eater_weapon_hit_01</soundDef> <!-- 光束发射瞬间播放一次的高能脉冲音。 -->
      </li>
    </comps>
  </AbilityDef>

  <AbilityDef>
    <defName>SRA_Spawn_SRA_Executor_Attack</defName>
    <label>星规执行单元：星弧破碎轰炸</label>
    <description>命令一艘星规执行单元进行轨道打击，扫射目标区域，并对敌方单位开火。</description>
    <iconPath>SRA/UI/Abilities/SRA_Long_Lance_Ability</iconPath>
    <cooldownTicksRange>1</cooldownTicksRange>
    <hotKey>Misc12</hotKey>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <warmupTime>1</warmupTime>
      <range>120</range>
      <targetable>true</targetable>
      <targetParams>
        <canTargetSelf>false</canTargetSelf>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <!-- <li Class="SRA.CompProperties_AircraftStrike">
        <requiredAircraftType>ARA_HiveCorvette_Entity</requiredAircraftType>
        <aircraftCooldownTicks>5000</aircraftCooldownTicks>
        <aircraftsPerUse>1</aircraftsPerUse>
      </li> -->
      <li Class="SRA.CompProperties_AbilitySpawnFlyOver">
        <flyOverDef>SRA_FlyOver_Executor</flyOverDef>
        <flyOverType>GroundStrafing</flyOverType>
        <flightSpeed>4</flightSpeed>
        <altitude>20</altitude>
        <playFlyOverSound>true</playFlyOverSound>
        <approachType>Perpendicular</approachType>

        <!-- 扫射参数 -->
        <enableGroundStrafing>true</enableGroundStrafing>
        <strafeWidth>8</strafeWidth>
        <strafeLength>64</strafeLength>
        <strafeFireChance>0.05</strafeFireChance>
        <minStrafeProjectiles>32</minStrafeProjectiles>
        <maxStrafeProjectiles>32</maxStrafeProjectiles>

        <!-- 只传递信号，不传递具体参数 -->
        <enableSectorSurveillance>true</enableSectorSurveillance>

        <!-- 可视化 -->
        <showStrafePreview>true</showStrafePreview>
        <strafePreviewColor>(1.0,0.3,0.1,0.2)</strafePreviewColor>

        <!-- 预览配置 -->
        <showSectorPreview>true</showSectorPreview>
        <sectorPreviewColor>(0.3,0.7,1.0,0.3)</sectorPreviewColor>
      </li>
    </comps>
  </AbilityDef>

</Defs>
