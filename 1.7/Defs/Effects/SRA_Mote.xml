  <!-- 征洋戮海的短生命周期控制器；真正的光束由它生成并维护的 Mote 绘制。 -->
  <ThingDef ParentName="MoteBase">
    <defName>SRA_ExcaliburBeam</defName>
    <thingClass>SRA.Thing_ExcaliburBeam</thingClass>
    <label>Excalibur beam controller</label>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>

    <!-- 控制器本体不可见，避免与专用主束发生重复绘制。 -->
    <graphicData>
      <texPath>Things/Mote/PowerBeam</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>(0.01, 0.01)</drawSize>
      <color>(1, 1, 1, 0)</color>
    </graphicData>

    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>999999</solidTime> <!-- 生命周期由 Thing_ExcaliburBeam 的 tick 逻辑控制。 -->
      <fadeOutTime>0</fadeOutTime>
      <needsMaintenance>false</needsMaintenance>
    </mote>
  </ThingDef>
</Defs>
